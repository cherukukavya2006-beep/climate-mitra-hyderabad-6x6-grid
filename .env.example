# Gemini API Key for Climate Mitra AI Assistant (Server-side only, never exposed to the browser)
# Local: put it in .env. Vercel: Project Settings -> Environment Variables (do NOT commit it).
GEMINI_API_KEY=your_gemini_api_key_here
# Optional: Gemini model to try first (falls back to the built-in model list)
# GEMINI_MODEL=gemini-flash-latest
# Optional: total time budget (ms) for Gemini per request before falling back to live weather data
# GEMINI_TIMEOUT_MS=25000

# Optional legacy & other settings
FLASK_ENV=development
SECRET_KEY=change_this
OPENAI_API_KEY=your_openai_key
SARVAM_API_KEY=your_sarvam_key
MONGO_URI=mongodb://localhost:27017/climate_mitra
WEATHER_API_URL=https://api.open-meteo.com/v1/forecast
SARVAM_AGENT_ID=your_agent_id
SARVAM_PHONE_NUMBER=your_phone_number

